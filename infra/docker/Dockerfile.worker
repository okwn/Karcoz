# Worker service — REMOVED from docker-compose (apps/worker/ is empty)
# No background job processing is currently required.
#
# To re-add a worker:
# 1. Implement worker logic in apps/worker/src/index.ts
# 2. Uncomment the worker service in infra/docker/docker-compose.yml
# 3. Uncomment the worker service in infra/docker/docker-compose.prod.yml
# 4. Update the build context to point to apps/worker
#
# Placeholder that does nothing — keeps the file around for future use.
FROM node:22-alpine

WORKDIR /app

RUN addgroup -S karcoz && adduser -S karcoz -G karcoz

USER karcoz

# Noop healthcheck — service is disabled
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
  CMD exit 0

CMD ["tail", "-f", "/dev/null"]