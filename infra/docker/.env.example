# KARÇÖZ — Docker Compose Production Environment Variables
# Copy this file to .env at the project root and fill in all values.
# NEVER commit .env to version control.
# Usage: docker compose -f infra/docker/docker-compose.prod.yml --env-file .env up -d

# ── Database ──────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_generate_a_strong_random_string
DATABASE_URL=postgresql://karcoz:${DB_PASSWORD}@db:5432/karcoz_db

# ── Redis ────────────────────────────────────────────────────────
# Required in production — Redis without a password is insecure.
REDIS_PASSWORD=CHANGE_ME_generate_a_strong_random_string
# REDIS_URL uses the password when REDIS_PASSWORD is set:
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Session ───────────────────────────────────────────────────────
# Minimum 32 characters. Server refuses to start in production without this.
SESSION_SECRET=CHANGE_ME_minimum_32_characters_long_secret_here

# ── Application ──────────────────────────────────────────────────
NODE_ENV=production
PORT=8000
# Must be a public HTTPS URL in production. Never use localhost.
MAGIC_LINK_BASE_URL=https://yourdomain.com
APP_BASE_URL=https://yourdomain.com

# ── AI Providers ────────────────────────────────────────────────
# Set AI_PROVIDER to use real AI. MockProvider is used when unset or MOCK_AI=true.
AI_PROVIDER=mock           # openai | openrouter | mock (default: mock)
AI_FALLBACK_PROVIDER=openrouter
AI_TIMEOUT_MS=30000       # timeout per request in ms (max 120000)
AI_MAX_TOKENS=2048
MOCK_AI=false              # set to true to force mock even if API keys exist

# ── OpenAI ───────────────────────────────────────────────────────
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# ── OpenRouter ───────────────────────────────────────────────────
# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── Telegram Bot ─────────────────────────────────────────────────
# Required for the Telegram bot service to function.
# Leave blank to disable the Telegram bot entirely.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ── Docker ports (host mappings — only needed for direct access) ──
# These map internal container ports to host ports.
# In production, only nginx needs to reach these, so they can be disabled.
# API_PORT=8132
# WEB_PORT=3100
# DB_PORT=5433
# REDIS_PORT=6380

# ── CORS ─────────────────────────────────────────────────────────
# In production, set to your exact domain(s).
# The API validates this against MAGIC_LINK_BASE_URL.
# ALLOWED_ORIGINS=https://yourdomain.com
