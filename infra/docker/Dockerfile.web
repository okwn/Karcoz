FROM node:22-alpine

RUN addgroup -S karcoz && adduser -S karcoz -G karcoz

WORKDIR /app

COPY package*.json ./
RUN npm install --ignore-scripts

COPY public/ ./public/

RUN chown -R karcoz:karcoz /app

USER karcoz

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

# Simple static file server — replace with nginx serving built files in real deployment
CMD ["node_modules/.bin/npx", "serve", "public", "-l", "3000", "--no-clipboard"]